{
  "name": "tiktok-snake-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous AI Snake vs TikTok LIVE Viewers Interactive Game",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,game\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:game\"",
    "dev:server": "npm run dev -w @snake-live/server",
    "dev:game": "npm run dev -w @snake-live/game",
    "restart": "node scripts/restart.mjs",
    "restart:server": "node scripts/restart.mjs server",
    "restart:game": "node scripts/restart.mjs game",
    "restart:round": "node scripts/restart-round.mjs",
    "clean:ports": "node scripts/clean-ports.mjs",
    "build": "npm run build --workspaces",
    "start": "npm run start -w @snake-live/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css,html}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
