# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Game Configuration
TICK_RATE=15
GRID_WIDTH=27
GRID_HEIGHT=48
AUTO_RESTART_DELAY_MS=7000

# TikTok LIVE Configuration
# Set to 'mock' for local simulation without TikTok credentials
# Set to 'tiktok' to connect to a live TikTok channel
TIKTOK_PROVIDER=mock
# The TikTok username whose LIVE stream to connect to (e.g., @streamer)
TIKTOK_USERNAME=

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL_MS=30000
WS_SNAPSHOT_INTERVAL_MS=50

# Client Configuration (used by Vite)
VITE_SERVER_HTTP_URL=http://localhost:3001
VITE_SERVER_WS_URL=ws://localhost:3001/ws
VITE_OBS_TRANSPARENT_BG=false
