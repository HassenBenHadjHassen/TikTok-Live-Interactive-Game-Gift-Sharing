{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@snake-live/shared": ["packages/shared/src"],
      "@snake-live/shared/*": ["packages/shared/src/*"],
      "@snake-live/gift-config": ["packages/gift-config/src"],
      "@snake-live/gift-config/*": ["packages/gift-config/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build"]
}
